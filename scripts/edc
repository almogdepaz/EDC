#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  edc build --agent claude|cursor|codex [path] [--force] [--focus <module>] [--ignore <glob>]...
  edc review --agent claude|cursor|codex [target] [--base <ref>] [--ignore <glob>]... [--context-mode advisory|inject]
  edc mode advisory|inject
  edc doctor

Commands:
  build   Build or update .context/ in the target repo
  review  Run the differential review pipeline (auto-builds/updates context if needed)
  mode    Set policy.defaultMode in .context/manifest.json (advisory or inject)
  doctor  Validate the v2 context tree and manifest routing contract

Notes:
  --agent is required for build and review.
  build defaults path to the current directory.
  --ignore may be repeated. If any --ignore flags are passed, .edcignore is ignored for that run.
  review delegates to the shared edc-review orchestrator.
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 2
}

require_command() {
  local agent="$1"
  case "$agent" in
    claude)
      command -v claude > /dev/null 2>&1 || die "--agent claude specified but 'claude' not found on PATH"
      ;;
    cursor)
      command -v cursor > /dev/null 2>&1 || die "--agent cursor specified but 'cursor' not found on PATH"
      ;;
    codex)
      command -v codex > /dev/null 2>&1 || die "--agent codex specified but 'codex' not found on PATH"
      ;;
    *)
      die "--agent must be one of: claude, cursor, codex"
      ;;
  esac
}

join_args() {
  local result=""
  local arg
  for arg in "$@"; do
    result="${result:+$result }$arg"
  done
  printf '%s' "$result"
}

find_skill() {
  local name="$1"
  shift
  local base
  for base in "$@"; do
    if [ -f "$base/$name/SKILL.md" ]; then
      printf '%s\n' "$base/$name/SKILL.md"
      return 0
    fi
  done
  return 1
}

find_cursor_build_skill() {
  find_skill "edc-build-impl" \
    "$REPO_ROOT/plugins/edc/skills" \
    ".cursor/skills" \
    "$HOME/.cursor/skills"
}

find_codex_build_skill() {
  find_skill "edc-build-impl" \
    "$REPO_ROOT/plugins/edc/skills" \
    ".codex/skills" \
    "$HOME/.codex/skills"
}

resolve_build_prompt() {
  local agent="$1"
  shift
  local arg_string
  arg_string="$(join_args "$@")"

  case "$agent" in
    claude)
      printf '/edc:edc-build%s\n' "${arg_string:+ $arg_string}"
      ;;
    cursor)
      local skill
      skill="$(find_cursor_build_skill)" || die "edc-build-impl not found. Install EDC Cursor skills first."
      if [ -n "$arg_string" ]; then
        printf 'When following the skill instructions below, use these CLI arguments: %s\n\n' "$arg_string"
      fi
      cat "$skill"
      ;;
    codex)
      local skill
      skill="$(find_codex_build_skill)" || die "edc-build-impl not found. Install EDC Codex skills first."
      if [ -n "$arg_string" ]; then
        printf 'When following the skill instructions below, use these CLI arguments: %s\n\n' "$arg_string"
      fi
      cat "$skill"
      ;;
  esac
}

find_review_script() {
  local candidate
  for candidate in \
    "$SCRIPT_DIR/edc-review.sh" \
    ".edc/scripts/edc-review.sh" \
    "$HOME/.edc/scripts/edc-review.sh"
  do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

find_doctor_script() {
  local candidate
  for candidate in \
    "$REPO_ROOT/plugins/edc/scripts/edc-doctor.sh" \
    ".edc/scripts/edc-doctor.sh" \
    "$HOME/.edc/scripts/edc-doctor.sh"
  do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

read_manifest_default_mode() {
  local manifest=".context/manifest.json"
  [ -f "$manifest" ] || return 0
  command -v jq > /dev/null 2>&1 || die "jq is required to read $manifest"
  jq -r '.policy.defaultMode // empty' "$manifest"
}

validate_context_mode() {
  local mode="$1"
  [ -n "$mode" ] || return 0
  case "$mode" in
    advisory|inject) ;;
    *) die "--context-mode must be advisory or inject" ;;
  esac
}

enforce_agent_context_mode() {
  local agent="$1" mode="$2"
  [ -n "$mode" ] || return 0
  if [ "$agent" != "claude" ]; then
    echo "edc: $agent/$mode not yet implemented" >&2
    exit 2
  fi
}

run_doctor_in_dir() {
  local target="$1"
  local doctor_script
  doctor_script="$(cd "$target" && find_doctor_script)" \
    || die "edc-doctor.sh not found. Install EDC first or run from the repo root."
  (cd "$target" && bash "$doctor_script")
}

build_cmd() {
  local agent=""
  local target="."
  local positional_target=""
  local -a passthrough=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)
        [ "$#" -ge 2 ] || die "--agent requires a value"
        agent="$2"
        shift 2
        ;;
      --force)
        passthrough+=("$1")
        shift
        ;;
      --focus)
        [ "$#" -ge 2 ] || die "--focus requires a module name"
        passthrough+=("$1" "$2")
        shift 2
        ;;
      --ignore)
        [ "$#" -ge 2 ] || die "--ignore requires a glob pattern"
        passthrough+=("$1" "$2")
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*)
        die "unknown build option: $1"
        ;;
      *)
        if [ -n "$positional_target" ]; then
          die "build accepts at most one path"
        fi
        positional_target="$1"
        shift
        ;;
    esac
  done

  [ -n "$agent" ] || die "--agent is required"
  require_command "$agent"

  if [ -n "$positional_target" ]; then
    target="$positional_target"
  fi
  [ -d "$target" ] || die "build target directory not found: $target"

  local prompt
  prompt="$(cd "$target" && resolve_build_prompt "$agent" "${passthrough[@]}")"

  case "$agent" in
    claude)
      (
        cd "$target"
        claude -p \
          --allowed-tools "Skill,Bash,Read,Write,Edit,Grep,Glob" \
          <<< "$prompt"
      )
      ;;
    cursor)
      (
        cd "$target"
        cursor agent -p --force --trust <<< "$prompt"
      )
      ;;
    codex)
      (
        cd "$target"
        codex exec --sandbox workspace-write - <<< "$prompt"
      )
      ;;
  esac

  run_doctor_in_dir "$target"
}

review_cmd() {
  local agent=""
  local context_mode=""
  local -a passthrough=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)
        [ "$#" -ge 2 ] || die "--agent requires a value"
        agent="$2"
        shift 2
        ;;
      --base)
        [ "$#" -ge 2 ] || die "--base requires a ref (e.g. --base main)"
        passthrough+=("$1" "$2")
        shift 2
        ;;
      --ignore)
        [ "$#" -ge 2 ] || die "--ignore requires a glob pattern (e.g. --ignore 'vendor/**')"
        passthrough+=("$1" "$2")
        shift 2
        ;;
      --context-mode)
        [ "$#" -ge 2 ] || die "--context-mode requires a value"
        context_mode="$2"
        passthrough+=("$1" "$2")
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        passthrough+=("$1")
        shift
        ;;
    esac
  done

  [ -n "$agent" ] || die "--agent is required"
  validate_context_mode "$context_mode"
  if [ -z "$context_mode" ]; then
    context_mode="$(read_manifest_default_mode)"
    validate_context_mode "$context_mode"
  fi
  enforce_agent_context_mode "$agent" "$context_mode"
  require_command "$agent"

  local review_script
  review_script="$(find_review_script)" \
    || die "edc-review.sh not found. Install EDC first or run from a repo with .edc/scripts/edc-review.sh"

  EDC_AGENT_CLI="$agent" EDC_CONTEXT_MODE="$context_mode" bash "$review_script" "${passthrough[@]}"
}

doctor_cmd() {
  local doctor_script
  doctor_script="$(find_doctor_script)" \
    || die "edc-doctor.sh not found. Install EDC first or run from the repo root."
  bash "$doctor_script"
}

mode_cmd() {
  local mode="${1:-}"
  case "$mode" in
    advisory|inject) ;;
    "")
      local current
      current="$(read_manifest_default_mode)"
      [ -n "$current" ] || die ".context/manifest.json not found or missing policy.defaultMode"
      printf '%s\n' "$current"
      return 0
      ;;
    *) die "edc mode: argument must be 'advisory' or 'inject' (got: $mode)" ;;
  esac

  local manifest=".context/manifest.json"
  [ -f "$manifest" ] || die "$manifest not found (run 'edc build' first)"
  command -v jq > /dev/null 2>&1 || die "jq is required to update $manifest"

  local tmp
  tmp="$(mktemp)"
  jq --arg mode "$mode" '.policy.defaultMode = $mode' "$manifest" > "$tmp"
  mv "$tmp" "$manifest"
  echo "policy.defaultMode set to $mode in $manifest"
}

main() {
  [ "$#" -gt 0 ] || {
    usage
    exit 2
  }

  local command="$1"
  shift

  case "$command" in
    build)
      build_cmd "$@"
      ;;
    review)
      review_cmd "$@"
      ;;
    mode)
      mode_cmd "$@"
      ;;
    doctor)
      doctor_cmd "$@"
      ;;
    --help|-h|help)
      usage
      ;;
    *)
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
