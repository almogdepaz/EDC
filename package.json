{
  "name": "@sgtbeatdown/edc",
  "version": "1.1.0",
  "description": "EDC — Every Day Carry skills for AI coding agents. Deep codebase understanding and context-aware code review.",
  "type": "module",
  "author": "sgtbeatdown",
  "license": "MIT",
  "homepage": "https://github.com/almogdepaz/edc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almogdepaz/edc.git"
  },
  "bugs": {
    "url": "https://github.com/almogdepaz/edc/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "edc",
    "code-review",
    "architecture",
    "context",
    "claude-code",
    "cursor",
    "codex"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "agents/pi/**",
    "plugins/edc/.claude-plugin/**",
    "plugins/edc/commands/**",
    "plugins/edc/hooks/**",
    "plugins/edc/prompt-bundles/**",
    "plugins/edc/scripts/**",
    "plugins/edc/skills/**",
    "plugins/edc/README.md",
    "install.sh",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./agents/pi/index.mjs"
    ]
  },
  "scripts": {
    "test": "for t in tests/hardening/*.sh; do bash \"$t\" || exit 1; done",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  }
}
